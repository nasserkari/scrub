#!/usr/bin/env bash
set -euo pipefail

COLOR_RED=''
COLOR_GREEN=''

STYLE_BOLD=''
STYLE_DIM=''
STYLE_RESET=''

# Enable colors for terminal output.
if [[ -t 1 ]]; then
    COLOR_RED=$'\033[31m'
    COLOR_GREEN=$'\033[32m'

    STYLE_BOLD=$'\033[1m'
    STYLE_DIM=$'\033[2m'
    STYLE_RESET=$'\033[0m'
fi

INSTALL_URI="https://raw.githubusercontent.com/nasserkari/wren/main/wren"
INSTALL_DIR="$HOME/.wren"
BIN_DIR="$INSTALL_DIR/bin"
EXE="$BIN_DIR/wren"

error() {
    echo -e "${COLOR_RED}error:${STYLE_RESET} $*" >&2
    exit 1
}

info() {
    echo -e "${STYLE_DIM}$*${STYLE_RESET}"
}

bold() {
    echo -e "${STYLE_BOLD}$*${STYLE_RESET}"
}

success() {
    echo -e "${COLOR_GREEN}$*${STYLE_RESET}"
}

# Detect the user's login shell.
case "$(basename "${SHELL:-bash}")" in
bash)
    CONFIG="$HOME/.bashrc"
    LINE="export PATH=\"$BIN_DIR:\$PATH\""
    ;;
zsh)
    CONFIG="$HOME/.zshrc"
    LINE="export PATH=\"$BIN_DIR:\$PATH\""
    ;;
fish)
    CONFIG="$HOME/.config/fish/config.fish"
    LINE="fish_add_path \"$BIN_DIR\""
    ;;
*)
    error "Unsupported shell. Add $BIN_DIR to PATH manually"
    ;;
esac

# Create the install directory.
info "Installing wren..."

if ! mkdir -p "$BIN_DIR"; then
    error "Cannot create install directory"
fi

# Download the executable.
if ! curl -fsSL "$INSTALL_URI" -o "$EXE"; then
    rm -f "$EXE"
    error "Download failed"
fi

# Make it executable.
if ! chmod +x "$EXE"; then
    error "Cannot make wren executable"
fi

# Configure PATH.
info "Updating PATH..."

if ! mkdir -p "$(dirname "$CONFIG")"; then
    error "Cannot create shell config directory"
fi

if ! touch "$CONFIG"; then
    error "Cannot access shell config"
fi

if ! grep -Fq -- "$BIN_DIR" "$CONFIG"; then
    {
        echo
        echo "# wren"
        echo "$LINE"
    } >>"$CONFIG" || error "Cannot update shell config"
fi

cat <<EOF
wren installed! Happy cleaning!    

Restart your terminal, then run:

  wren --clean
EOF
